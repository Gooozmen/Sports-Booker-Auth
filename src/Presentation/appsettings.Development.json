{
  "AzureKeyVault": 
  {
    "VaultUri": ""
  },
  "ConnectionStrings": 
  {
    "AuthDb": "",
    "Redis":"",
    "Elastic": ""
  },
  "EntityFramework": 
  {
    "ExecuteReBuild": false
  },
  "Jwt": 
  {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  },
  "Serilog": 
  {
    "Using": [ "Elastic.Serilog.Sinks", "Serilog.Sinks.Console", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": 
    {
      "Default": "Information",
      "Override": 
      {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithThreadId"
    ],
    "WriteTo": 
    [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "Silent",
          "nodes":  ["http://localhost:9200"],
          "dataStream" : "courtbooker.auth.api.dev",
          "AutoRegisterTemplate": true,
          "MapCustomFields": true,
          "UseDataStream": true,
          "includeHost" : true,
          "includeUser" : true,
          "includeProcess" : true,
          "includeActivity" : true,
          "debugMode": true
        }
      }
    ]
  }
}