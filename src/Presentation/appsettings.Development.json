{
  "ConnectionStrings": {
    "AuthDb": "",
    "Redis":""
  },
  "EntityFramework": {
    "ExecuteSeeders": false,
    "ExecuteReBuild": false
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 30
  },
  "Serilog": {
    "Using": [ "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "YourAppNamespace": "Information", 
        "Microsoft": "None",                 
        "System": "None"                     
      }
    },
    "WriteTo": [
      {
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "Silent",
          "nodes": [ "http://localhost:9200" ],
          "dataStream" : "logs-dotnet-dev",
          "includeHost" : true,
          "includeUser" : true,
          "includeProcess" : true,
          "includeActivity" : true,
          "debugMode": false
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Auth-Service-Api"
    }
  }
}


