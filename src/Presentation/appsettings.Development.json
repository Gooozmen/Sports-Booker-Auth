{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDb": "",
    "Redis":""
  },
  "EntityFramework": {
    "ExecuteSeeders": true,
    "ExecuteReBuild": true
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {"Name": "Console"},
      {
        "Name": "Seq",
        "Args": {"serverUrl": "http://localhost:5341/"}
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Auth-Service-Api"
    }
  }
}


