{
  "EntityFramework": {
    "ExecuteReBuild": false
  },
  "AzureKeyVault": {
    "VaultUri": "https://courtbooker-kv.vault.azure.net/"
  },
  "ConnectionStrings": {
    "AuthDb": "",
    "Redis": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 30
  },
  "Elastic": {
    "Node": "",
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [
      "Elastic.Serilog.Sinks",
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "Silent",
          "nodes": [
            ""
          ],
          "apiKey": "",
          "dataStream": "courtbooker.auth.api-azure",
          "AutoRegisterTemplate": true,
          "MapCustomFields": true,
          "UseDataStream": true,
          "includeHost": true,
          "includeUser": true,
          "includeProcess": true,
          "includeActivity": true,
          "debugMode": true,
          "CustomFormatter": "Elastic.CommonSchema.Serilog.Formatting.Ecs.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
